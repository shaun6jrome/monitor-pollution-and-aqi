# Pollution Intelligence Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Database settings
SQLITE_DB_PATH=data/pollution_intelligence.db

# GDELT News Ingestion
GDELT_REQUEST_TIMEOUT=20
GDELT_CACHE_TTL_SECONDS=3600
GDELT_MAX_RECORDS=50

# Official Air Quality Portal / API (Optional)
# If using data.gov.in real-time air quality API, obtain a free API key at https://data.gov.in
DATA_GOV_IN_API_KEY=
CPCB_API_BASE_URL=https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# NLP and Embedding Model Settings
# Lightweight model: sentence-transformers/all-MiniLM-L6-v2 (with automatic TF-IDF fallback)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.68

# Logging
LOG_LEVEL=INFO
